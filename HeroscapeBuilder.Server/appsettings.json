{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.ChangeTracking": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MsSqlDb": "%ProjectMasterDb%"
  },
  "BlobStorage": {
    "Path": "https://files.heroscapebuilder.com/",
    "API": "files.heroscapebuilder.com",
    "User": "%MinioBlobStorage__ROOT_USER%",
    "Password": "%MinioBlobStorage__ROOT_PASSWORD%"
  },
  "Stripe": {
    "SecretKey": "%StripeSecretKey%",
    "WebhookSecret": "%StripeWebhookSecret%"
  },
  "Shop": {
    "SiteUrl": "https://heroscapebuilder.com",
    "Currency": "usd",
    "ShippingCountries": [ "US" ],
    "AutomaticTax": false
  },
  "Jwt": {
    "Key": "%JwtKey%",
    "Issuer": "heroscapebuilder.com",
    "Audience": "heroscapebuilder.com"
  }
}
