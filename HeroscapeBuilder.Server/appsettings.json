{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ForwardedHeaders": {
    "ForwardedForHeaderName": "X-Forwarded-For",
    "ForwardedProtoHeaderName": "X-Forwarded-Proto"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MsSqlDb": "%ProjectMasterDb%"
  },
  "BlobStorage": {
    "Path": "https://heroscapebuilder.com/file/",
    "API": "heroscapebuilder.com:2096",
    "User": "%MinioBlobStorage__ROOT_USER%",
    "Password": "%MinioBlobStorage__ROOT_PASSWORD%"
  },
  "Jwt": {
    "Key": "%JwtKey%",
    "Issuer": "heroscapebuilder.com",
    "Audience": "heroscapebuilder.com"
  }
}
